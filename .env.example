# Copy this file to .env and adjust as needed - ./dev.sh does this for you automatically on
# first run. Spring Boot (backend/src/main/resources/application.yml) and Vite
# (frontend/vite.config.ts) both read these as real process/OS environment variables - this
# .env file itself is not auto-loaded by either tool directly; ./dev.sh sources it into the
# shell before starting both apps. Running the backend by hand instead? Either source this
# file yourself first (`set -a; source .env; set +a`) or export the vars via your IDE's run
# configuration / a tool like direnv.
# Never commit a real .env file — it is gitignored.

# --- Backend: database (backend/src/main/resources/application.yml) ---
DB_URL=jdbc:postgresql://localhost:5432/cms
DB_USERNAME=cms
DB_PASSWORD=cms

# --- Backend: server ---
PORT=8080

# --- Backend: CORS — comma-separated origins allowed to call the API from a browser ---
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Backend: rate limiting on sensitive public endpoints (login/signup/registration) ---
# See com.cms.common.RateLimitingConfig. Per client IP, per protected path.
RATE_LIMIT_MAX_ATTEMPTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# --- Backend: JWT signing secrets ---
# Deliberately NO default in application.yml: if left unset, each of JwtService /
# StaffJwtService / SuperAdminJwtService generates a random signing key at startup instead of
# falling back to a guessable one (fail-safe, not fail-open). Every backend restart without
# these set invalidates all previously issued tokens — set them to a stable value for any
# session where that matters. Never share a value across the three; each identity system
# (patient / staff / super-admin) must have its own independent signing key.
PATIENT_JWT_SECRET=
STAFF_JWT_SECRET=
SUPER_ADMIN_JWT_SECRET=

# --- Backend: Super Admin console credentials ---
# Same fail-safe pattern as the JWT secrets above: unset means a random, unguessable
# username/password pair is generated at startup rather than a known default.
SUPER_ADMIN_USERNAME=
SUPER_ADMIN_PASSWORD=

# --- Backend: how long a rejected clinic/doctor registration sits before the nightly purge ---
ADMIN_REJECTION_RETENTION_DAYS=30

# --- Backend: notification stub logging (com.cms.notification.service.LoggingNotificationSender) ---
# Off by default (fail-safe) - the log-only notification stub never writes recipient contact
# info or message content to logs unless explicitly enabled here for local debugging.
NOTIFICATION_LOG_PII=false

# --- Backend: OWASP Dependency-Check CI gate (backend/build.gradle, .github/workflows/ci.yml) ---
# Free key from https://nvd.nist.gov/developers/request-an-api-key. The NVD has required a
# key for reliable data access since Feb 2023 - without one, the scan fails outright (not
# just slowly). Optional locally (the check just fails if unset); as a GitHub repo secret
# it's what turns the CI gate on at all - see ci.yml, which skips the scan with a warning
# if the secret isn't configured yet.
NVD_API_KEY=

# --- Frontend (frontend/.env or shell env before `npm run dev` / `npm run build`) ---
VITE_API_BASE_URL=http://localhost:8080
